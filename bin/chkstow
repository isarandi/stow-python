"""
chkstow - Check stow target directory for problems.

Modes:
    -b, --badlinks  Report symlinks pointing to non-existent files (default)
    -a, --aliens    Report non-symlink, non-directory files
    -l, --list      List packages in the target directory
"""

from __future__ import print_function

import os
import re
import stat
import sys

# Perl: $ENV{STOW_DIR} || '/usr/local/' - Perl truthiness makes both the
# empty string and "0" fall back to the default, not just an unset variable.
_stow_dir_env = os.environ.get('STOW_DIR')
if _stow_dir_env in (None, '', '0'):
    DEFAULT_TARGET = '/usr/local/'
else:
    DEFAULT_TARGET = _stow_dir_env

# Global state (matches Perl module structure for testability)
Wanted = None  # Will be set to a function
Package = {}
Stow_dir = ''
Target = DEFAULT_TARGET

# Perl compares strings by byte value when sorting; Python 3 compares the
# decoded code points instead, which orders file names that are not valid
# UTF-8 differently. Sorting on the raw bytes restores Perl's order. Under
# Python 2 a str already is bytes, so the default key is the right one.
if hasattr(os, 'fsencode'):
    BYTE_ORDER_KEY = os.fsencode
else:
    BYTE_ORDER_KEY = None


# ---------------------------------------------------------------------------
# Mode callbacks - called by File::Find-like walker
# ---------------------------------------------------------------------------


def bad_links(entry, full_path, is_link):
    """Perl: -l && !-e && print"""
    # Perl's -l uses cached stat from File::Find, so no extra lstat
    # Perl's !-e does stat to check if target exists
    if is_link and not os.path.exists(entry):
        print("Bogus link: %s" % full_path)


def aliens(entry, full_path, is_link):
    """Perl: !-l && !-d && print"""
    # Perl short-circuits: if -l is true, -d is not evaluated
    if is_link:
        return
    # For non-links, Perl's -d does stat
    is_dir = os.path.isdir(entry)
    if not is_dir:
        print("Unstowed file: %s" % full_path)


def list_pkg(entry, full_path, is_link):
    """Perl: -l && readlink"""
    if is_link:
        link_dest = os.readlink(entry)
        # Remove leading ../stow/ prefix
        link_dest = re.sub(r'^(?:\.\./)+stow/', '', link_dest)
        # Remove everything after first /
        link_dest = re.sub(r'/.*', '', link_dest)
        Package[link_dest] = 1


def skip_dirs(entries, dir_full_path):
    """Perl's File::Find preprocess hook: skip stow source and unstowed targets.

    Perl receives the directory's entries in @_ and returns the ones the
    walk should visit, naming the directory via the $File::Find::dir
    global; here that directory is passed in instead.
    """
    if _path_exists(".stow") or _path_exists(".notstowed"):
        sys.stderr.write("skipping %s\n" % dir_full_path)
        return []
    else:
        return entries


# ---------------------------------------------------------------------------
# File::Find emulation - matches Perl's syscall pattern exactly
# ---------------------------------------------------------------------------


def _under_target(target, relative):
    """Build the reported path of an entry below the walk's top item.

    Perl: _is_root($p_dir) ? "$p_dir$rel" : "$p_dir/$rel" - the root
    directory already ends in the separator, everything else needs one.
    """
    if target == "/":
        return target + relative
    return target + "/" + relative


def _path_exists(path):
    """Check if path exists using stat (like Perl's -e)."""
    try:
        os.stat(path)
        return True
    except OSError:
        return False


def _walk_target(target, wanted, preprocess):
    """Walk target directory, calling wanted callback for each entry.

    Matches Perl's File::Find behavior with chdir and relative paths.
    wanted(entry, full_path, is_link) is called with cwd set to entry's
    directory; preprocess(entries, dir) filters each directory's entries.
    """
    # File::Find saves cwd at start and returns to it at end
    start_cwd = os.getcwd()
    # The lstat sees the argument exactly as given, so a trailing slash
    # still forces the ENOTDIR of "file/".
    try:
        st = os.lstat(target)
    except OSError as e:
        stat_error = e
        st = None
    else:
        stat_error = None

    # Perl: $top_item =~ s|/\z|| unless _is_root($top_item) - exactly one
    # trailing slash goes, and the root directory keeps its own. Every
    # reported name and message below uses the shortened form.
    if target != "/" and target.endswith("/"):
        target = target[:-1]

    if st is None:
        # File::Find warns and checks nothing. Perl's warn appends its
        # " at <script> line N." source location, which the test harness
        # normalizes away like the other Perl warning locations.
        sys.stderr.write("Can't stat %s: %s\n" % (target, stat_error.strerror))
        return

    # File::Find does NOT descend a top-level argument that is not a
    # directory (a symlink to a directory is still a symlink here). It
    # chdirs to the argument's parent, lstats the basename again, calls
    # wanted() on it once, and chdirs back; $File::Find::name is "./x"
    # for a bare relative name. So "chkstow -a -t <symlink>" silently
    # checks nothing inside the link target, like Perl.
    if not stat.S_ISDIR(st.st_mode):
        dirname, basename = os.path.split(target)
        if dirname:
            full_name = target
            os.chdir(dirname + "/")
        else:
            full_name = "./" + target
            os.chdir("./")
        st = os.lstat(basename)
        wanted(basename, full_name, stat.S_ISLNK(st.st_mode))
        os.chdir(start_cwd)
        return

    # File::Find enters the top-level directory before reading it, and
    # omits the chdir when the target already is the current directory.
    # A failed chdir warns and checks nothing, but still returns to the
    # saved cwd below.
    if target != ".":
        try:
            os.chdir(target)
        except OSError as e:
            sys.stderr.write("Can't cd to %s: %s\n" % (target, e.strerror))
            os.chdir(start_cwd)
            return

    # Perl lstats the directory again for the wanted function's -l test
    os.lstat(".")

    for _depth in _file_find_chdir(target, "", wanted, preprocess, 1):
        pass

    # Final chdir back to saved cwd (Perl uses absolute path from getcwd)
    os.chdir(start_cwd)


def _file_find_chdir(target, prefix, wanted, preprocess, depth):
    """Recursive File::Find-like walker using chdir and relative paths.

    Matches Perl's File::Find syscall pattern exactly:
    - open(".") to read current directory
    - preprocess the entries (stats .stow/.notstowed)
    - For each entry: lstat to get type
      - If link: lstat again + readlink in wanted
      - If dir: just lstat (second lstat happens before chdir)
      - If file: lstat again + call wanted
    - Recurse into subdirs with lstat before each chdir
    - Multi-level chdir back (Perl optimization)

    Yields depth values. The final depth indicates how deep we are
    after processing, so caller can do multi-level chdir.
    """
    # Perl's $File::Find::dir: the full path from the start of the walk
    if prefix:
        dir_full_path = _under_target(target, prefix)
    else:
        dir_full_path = target

    # File::Find calls wanted on the root directory only (depth 1)
    if depth == 1:
        wanted(".", dir_full_path, False)  # "." is not a symlink

    # Open and read current directory entries (Perl uses ".")
    try:
        entries = os.listdir(".")
    except OSError as e:
        # A directory that can be entered but not read: File::Find warns
        # and skips it, the walk carries on with the rest of the tree.
        sys.stderr.write("Can't opendir(%s): %s\n" % (dir_full_path, e.strerror))
        return

    # Perl's File::Find hands the entries to the preprocess hook and walks
    # only what comes back
    entries = preprocess(entries, dir_full_path)

    # Process entries - Perl handles links immediately, defers dirs
    subdirs = []
    for entry in entries:
        try:
            st = os.lstat(entry)
        except OSError:
            continue

        is_dir = stat.S_ISDIR(st.st_mode)
        is_link = stat.S_ISLNK(st.st_mode)

        # Build full path (Perl's $File::Find::name)
        if prefix:
            full_path = os.path.join(prefix, entry)
        else:
            full_path = entry
        full_path = _under_target(target, full_path)

        if is_dir:
            # Dirs: just collect for later recursion
            subdirs.append((entry, full_path))
        else:
            # Files and symlinks: second lstat + wanted
            os.lstat(entry)
            wanted(entry, full_path, is_link)

    # Recurse into subdirectories with chdir
    # Track depth so we can do multi-level chdir back like Perl
    current_depth = depth
    for subdir, subdir_full_path in subdirs:
        # If we're deeper than expected, chdir back first
        if current_depth > depth:
            os.chdir("/".join([".."] * (current_depth - depth)))
            current_depth = depth

        os.lstat(subdir)  # Second lstat happens here, before chdir
        # Call wanted for dirs - generates stat for -d test
        wanted(subdir, subdir_full_path, False)
        try:
            os.chdir(subdir)
        except OSError as e:
            # File::Find warns and skips the subtree, naming the parent
            # directory in parentheses ('' rather than '/' for the root).
            parent_path = dir_full_path
            if parent_path == "/":
                parent_path = ""
            sys.stderr.write(
                "Can't cd to (%s/) %s: %s\n" % (parent_path, subdir, e.strerror)
            )
            continue
        current_depth += 1
        if prefix:
            new_prefix = os.path.join(prefix, subdir)
        else:
            new_prefix = subdir

        for result_depth in _file_find_chdir(target, new_prefix, wanted,
                                             preprocess, current_depth):
            if result_depth is not None:
                current_depth = result_depth

    # After all subdirs, yield final depth for parent
    yield current_depth


def check_stow():
    """Walk target directory and apply the Wanted function.

    Perl: find({wanted => $Wanted, preprocess => \\&skip_dirs}, $Target)
    """
    _walk_target(Target, Wanted, skip_dirs)

    if Wanted == list_pkg:
        Package.pop('', None)
        Package.pop('..', None)
        if Package:
            for pkg in sorted(Package.keys(), key=BYTE_ORDER_KEY):
                print(pkg)


# Option table mirroring Perl chkstow's GetOptions() spec
# ('b|badlinks', 'a|aliens', 'l|list', 't|target=s') under Getopt::Long's
# DEFAULT configuration: long names match case-insensitively, a unique
# prefix abbreviates, "+" works as an option prefix (getopt_compat), and
# there is no short-option bundling (so -tDIR is the unknown option
# "tDIR", while -t=DIR works). None marks the value-taking target option.
OPTION_SPECS = (
    (('b', 'badlinks'), bad_links),
    (('a', 'aliens'), aliens),
    (('l', 'list'), list_pkg),
    (('t', 'target'), None),
)


def find_option(name, allow_abbrev):
    """Resolve an option name like Getopt::Long's default find_option: an
    exact match on a name or alias wins, else a unique prefix resolves,
    both case-insensitively. Returns the matching spec, or None if the
    option is unknown. (No prefix is ambiguous between two of chkstow's
    specs, so there is no ambiguity error path.)
    """
    folded = name.lower()
    for spec in OPTION_SPECS:
        if folded in spec[0]:
            return spec
    if not allow_abbrev or not folded:
        return None
    hits = []
    for spec in OPTION_SPECS:
        for option_name in spec[0]:
            if option_name.startswith(folded):
                hits.append(spec)
                break
    if len(hits) == 1:
        return hits[0]
    return None


def process_options():
    """Process command line options like Perl's GetOptions(...) or usage().

    A bad option warns on stderr exactly like Getopt::Long, and after the
    remaining arguments have been checked ends in usage(), mirroring
    Perl's `GetOptions(...) or usage()`. Non-option arguments are
    skipped: Perl chkstow leaves them in @ARGV and never reads them.
    POSIXLY_CORRECT disables abbreviation and "+" prefixes and stops
    option processing at the first non-option argument (require_order).
    """
    global Wanted, Target

    posixly_correct = 'POSIXLY_CORRECT' in os.environ
    ok = True
    args = sys.argv[1:]
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == '--':
            break
        if arg.startswith('--'):
            name = arg[2:]
        elif len(arg) > 1 and (
            arg.startswith('-')
            or (arg.startswith('+') and not posixly_correct)
        ):
            name = arg[1:]
        else:
            if posixly_correct:
                break
            i += 1
            continue

        attached = None
        if '=' in name and not name.startswith('='):
            name, attached = name.split('=', 1)

        spec = find_option(name, not posixly_correct)
        if spec is None:
            sys.stderr.write("Unknown option: %s\n" % name)
            ok = False
        elif spec[1] is not None:
            if attached is not None:
                sys.stderr.write("Option %s does not take an argument\n" % name)
                ok = False
            else:
                Wanted = spec[1]
        elif attached is not None:
            Target = attached
        elif i + 1 < len(args):
            i += 1
            Target = args[i]
        else:
            sys.stderr.write("Option %s requires an argument\n" % name)
            ok = False
        i += 1

    if not ok:
        usage()


def usage():
    """Print usage message and exit."""
    print("""USAGE: chkstow [options]

Options:
    -t DIR, --target=DIR  Set the target directory to DIR
                          (default is %s)
    -b, --badlinks        Report symlinks that point to non-existent files
    -a, --aliens          Report non-symlinks in the target directory
    -l, --list            List packages in the target directory

--badlinks is the default mode.""" % DEFAULT_TARGET)
    sys.exit(0)


def pass_bytes_through_streams():
    """Report file names as the bytes they are, like Perl.

    Python 3 decodes undecodable file name bytes into surrogate escapes;
    encoding them back out is refused unless the stream asks for it, so a
    name that is not valid in the locale's encoding would abort the run
    instead of being printed. Under Python 2 the streams are byte streams
    already and there is nothing to configure.
    """
    if hasattr(sys.stdout, 'reconfigure'):
        sys.stdout.reconfigure(errors='surrogateescape')
    if hasattr(sys.stderr, 'reconfigure'):
        sys.stderr.reconfigure(errors='surrogateescape')


def main():
    """Main entry point."""
    global Wanted

    pass_bytes_through_streams()

    if len(sys.argv) == 1:
        usage()

    # Default mode is badlinks
    Wanted = bad_links

    process_options()
    check_stow()


# Alias for Perl compatibility - tests use chkstow.list
list = list_pkg


if __name__ == '__main__':
    main()
